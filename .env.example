# Default network. One of: mainnet | testnet | devnet | localnet
SUI_NETWORK=testnet

# Optional override of full node URL
# SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# Faucet URL (auto-derived from network if unset)
# SUI_FAUCET_URL=https://faucet.testnet.sui.io/v2/gas

# Path to Sui keystore. Defaults to ~/.sui/sui_config/sui.keystore
# SUI_KEYSTORE_PATH=

# Bech32 (suiprivkey1...) signer for scripts. NEVER commit a real value.
SUI_PRIVATE_KEY=

# Optional explicit sender address
# SUI_SENDER_ADDRESS=

# ── Walrus ──────────────────────────────────────────────────────────────
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
WALRUS_EPOCHS=5

# ── Seal ────────────────────────────────────────────────────────────────
SEAL_KEY_SERVERS=https://seal-key-server-testnet-1.mystenlabs.com,https://seal-key-server-testnet-2.mystenlabs.com
SEAL_THRESHOLD=2

# ── zkLogin ─────────────────────────────────────────────────────────────
ZK_LOGIN_PROVER_URL=https://prover-dev.mystenlabs.com/v1
ZK_LOGIN_SALT_URL=https://salt.api.mystenlabs.com/get_salt
GOOGLE_CLIENT_ID=
FACEBOOK_CLIENT_ID=
APPLE_CLIENT_ID=

# ── Sponsored transactions ──────────────────────────────────────────────
SPONSOR_SERVICE_URL=
SPONSOR_API_KEY=

# ── DeepBook ────────────────────────────────────────────────────────────
DEEPBOOK_INDEXER_URL=https://deepbook-indexer.mainnet.mystenlabs.com

# ── Lumiwave ────────────────────────────────────────────────────────────
LUMIWAVE_RPC_URL=https://rpc-mainnet.lumiwave.io
LUMIWAVE_API_KEY=

# ── Indexer ─────────────────────────────────────────────────────────────
INDEXER_GRAPHQL_URL=https://sui-testnet.mystenlabs.com/graphql

# ── Web app (Next.js public vars) ───────────────────────────────────────
NEXT_PUBLIC_SUI_NETWORK=testnet
NEXT_PUBLIC_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
NEXT_PUBLIC_WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
