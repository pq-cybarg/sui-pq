+    pub fn to_bytes(&self) -> Vec<u8> {
+        self.signing_key.to_vec()
+    }
+
+    /// Parse a 64-byte FIPS-205 signing key.
+    pub fn from_bytes(bytes: &[u8]) -> Result<Self, eyre::Report> {
