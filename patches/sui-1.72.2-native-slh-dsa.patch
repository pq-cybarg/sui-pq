+/// Post-quantum SLH-DSA (FIPS-205) keys can be derived from a BIP-39 mnemonic
+/// just like the elliptic-curve schemes: the derivation is deterministic, the
+/// address is derived from the 0x07-flagged public key, a different scheme on
+/// the same phrase yields a different address, and the stored key round-trips.
+#[tokio::test]
+async fn slh_dsa_mnemonic_derivation_test() -> Result<(), anyhow::Error> {
+    let phrase = "result crisp session latin must fruit genuine question prevent start coconut brave speak student dismiss";
+
+    // Importing the same phrase twice yields the same SLH-DSA address.
+    let mut ks1 = Keystore::from(InMemKeystore::default());
+    let a1 = ks1
+        .import_from_mnemonic(phrase, SignatureScheme::SlhDsa, None, None)
+        .await
+        .unwrap();
+    let mut ks2 = Keystore::from(InMemKeystore::default());
+    let a2 = ks2
+        .import_from_mnemonic(phrase, SignatureScheme::SlhDsa, None, None)
+        .await
+        .unwrap();
+    assert_eq!(a1, a2, "same mnemonic must derive the same SLH-DSA address");
+
+    // The address is exactly blake2b256(0x07 || pk).
+    let pubkey = ks1.entries()[0].clone();
+    assert_eq!(pubkey.flag(), SignatureScheme::SlhDsa.flag());
+    assert_eq!(pubkey.flag(), 0x07);
+    let mut hasher = DefaultHash::default();
+    hasher.update([pubkey.flag()]);
+    hasher.update(&pubkey);
+    let g_arr = hasher.finalize();
+    let mut res = [0u8; SUI_ADDRESS_LENGTH];
+    res.copy_from_slice(&AsRef::<[u8]>::as_ref(&g_arr)[..SUI_ADDRESS_LENGTH]);
+    assert_eq!(SuiAddress::try_from(res.as_slice())?, a1);
+
+    // The public key is the FIPS-205 SLH-DSA-SHA2-128s size (32 bytes).
+    assert_eq!(AsRef::<[u8]>::as_ref(&pubkey).len(), 32);
+
+    // A different scheme on the same phrase derives a different address.
+    let mut ks3 = Keystore::from(InMemKeystore::default());
+    let ed = ks3
+        .import_from_mnemonic(phrase, SignatureScheme::ED25519, None, None)
+        .await
+        .unwrap();
+    assert_ne!(ed, a1, "ED25519 and SLH-DSA must not collide on one phrase");
+
+    // The stored key pair round-trips through `flag || privkey` bytes.
+    let kp = ks1.export(&a1).unwrap();
+    let bytes = kp.to_bytes();
+    assert_eq!(bytes[0], 0x07, "key encodes the SLH-DSA flag");
+    assert_eq!(bytes.len(), 1 + 64, "flag + 64-byte FIPS-205 signing key");
+    let decoded = SuiKeyPair::from_bytes(&bytes).unwrap();
+    assert_eq!(SuiAddress::from(&decoded.public()), a1);
+
+    Ok(())
+}
