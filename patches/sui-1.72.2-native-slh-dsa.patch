diff --git a/crates/sui-types/src/slh_dsa_authenticator.rs b/crates/sui-types/src/slh_dsa_authenticator.rs
new file mode 100644
index 00000000..2a379491
--- /dev/null
+++ b/crates/sui-types/src/slh_dsa_authenticator.rs
@@ -0,0 +1,253 @@
+// Copyright (c) Mysten Labs, Inc.
+// SPDX-License-Identifier: Apache-2.0
+//
+// Drop this file into `crates/sui-types/src/slh_dsa_authenticator.rs` of a Sui
+// checkout and wire it up per ../INTEGRATION.md. It adds a native, post-quantum
+// `GenericSignature::SlhDsaAuthenticator` so a transaction can be authenticated
+// with ONLY a FIPS-205 SLH-DSA-SHA2-128s signature — no elliptic curve.
+//
+// Modeled on `passkey_authenticator.rs`; the verification is simpler (a raw
+// pk+sig over the standard signing digest). Crypto comes from the workspace's
+// `slh-dsa-sui` crate (RustCrypto `slh-dsa`), which interoperates with the
+// `@sui-gen/pqc` / @noble signer (see crates/slh-dsa-sui/tests/kat.rs).
+
+use crate::crypto::{DefaultHash, PublicKey, SignatureScheme};
+use crate::signature_verification::VerifiedDigestCache;
+use crate::{
+    base_types::{EpochId, SuiAddress},
+    digests::ZKLoginInputsDigest,
+    error::{SuiErrorKind, SuiResult},
+    signature::{AuthenticatorTrait, VerifyParams},
+};
+use fastcrypto::error::FastCryptoError;
+use fastcrypto::hash::HashFunction;
+use fastcrypto::traits::ToFromBytes;
+use once_cell::sync::OnceCell;
+use schemars::JsonSchema;
+use serde::{Deserialize, Serialize};
+use shared_crypto::intent::IntentMessage;
+use std::hash::{Hash, Hasher};
+use std::sync::Arc;
+
+pub const SLH_DSA_PK_BYTES: usize = 32;
+pub const SLH_DSA_SIG_BYTES: usize = 7856;
+
+/// Native SLH-DSA-SHA2-128s authenticator.
+///
+/// Wire format (after the 1-byte `GenericSignature` scheme flag handled by
+/// `GenericSignature::from_bytes`): `pk (32) || sig (7856)`.
+#[derive(Debug, Clone, JsonSchema)]
+pub struct SlhDsaAuthenticator {
+    pk: Vec<u8>,
+    sig: Vec<u8>,
+    #[serde(skip)]
+    bytes: OnceCell<Vec<u8>>,
+}
+
+/// Raw form used for (de)serialization: the flagged blob `flag || pk || sig`.
+#[derive(Serialize, Deserialize, Debug)]
+pub struct RawSlhDsaAuthenticator {
+    pub pk: Vec<u8>,
+    pub sig: Vec<u8>,
+}
+
+impl SlhDsaAuthenticator {
+    pub fn get_pk(&self) -> SuiResult<PublicKey> {
+        Ok(PublicKey::SlhDsa(crate::crypto::SlhDsaPublicKeyAsBytes(
+            self.pk.clone(),
+        )))
+    }
+
+    /// Construct an authenticator from a raw public key (32 B) and signature
+    /// (7856 B), as produced by [crate::crypto::SuiKeyPair::sign_secure_generic].
+    pub fn from_pk_sig(pk: Vec<u8>, sig: Vec<u8>) -> Self {
+        SlhDsaAuthenticator {
+            pk,
+            sig,
+            bytes: OnceCell::new(),
+        }
+    }
+}
+
+impl PartialEq for SlhDsaAuthenticator {
+    fn eq(&self, other: &Self) -> bool {
+        self.pk == other.pk && self.sig == other.sig
+    }
+}
+impl Eq for SlhDsaAuthenticator {}
+impl Hash for SlhDsaAuthenticator {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        self.as_ref().hash(state);
+    }
+}
+
+impl AuthenticatorTrait for SlhDsaAuthenticator {
+    fn verify_user_authenticator_epoch(
+        &self,
+        _epoch: EpochId,
+        _max_epoch_upper_bound_delta: Option<u64>,
+    ) -> SuiResult {
+        Ok(())
+    }
+
+    fn verify_claims<T>(
+        &self,
+        intent_msg: &IntentMessage<T>,
+        author: SuiAddress,
+        _aux_verify_data: &VerifyParams,
+        _zklogin_inputs_cache: Arc<VerifiedDigestCache<ZKLoginInputsDigest>>,
+    ) -> SuiResult
+    where
+        T: Serialize,
+    {
+        // 1. Address must be derived from this public key.
+        if author != SuiAddress::from(&self.get_pk()?) {
+            return Err(SuiErrorKind::InvalidSignature {
+                error: "Invalid author for SLH-DSA".to_string(),
+            }
+            .into());
+        }
+
+        // 2. Signing message = hash(intent || bcs(tx)) — the same digest Sui
+        //    computes for every scheme.
+        let message = to_signing_message(intent_msg);
+
+        // 3. Verify the post-quantum signature (never panics; returns bool).
+        if slh_dsa_verify(&self.pk, &message, &self.sig) {
+            Ok(())
+        } else {
+            Err(SuiErrorKind::InvalidSignature {
+                error: "SLH-DSA signature verification failed".to_string(),
+            }
+            .into())
+        }
+    }
+}
+
+impl AsRef<[u8]> for SlhDsaAuthenticator {
+    fn as_ref(&self) -> &[u8] {
+        self.bytes
+            .get_or_init(|| {
+                let mut bytes = Vec::with_capacity(1 + self.pk.len() + self.sig.len());
+                bytes.push(SignatureScheme::SlhDsa.flag());
+                bytes.extend_from_slice(&self.pk);
+                bytes.extend_from_slice(&self.sig);
+                bytes
+            })
+            .as_slice()
+    }
+}
+
+impl ToFromBytes for SlhDsaAuthenticator {
+    fn from_bytes(bytes: &[u8]) -> Result<Self, FastCryptoError> {
+        // `bytes` includes the leading scheme flag.
+        if bytes.is_empty() || bytes[0] != SignatureScheme::SlhDsa.flag() {
+            return Err(FastCryptoError::InvalidInput);
+        }
+        let body = &bytes[1..];
+        if body.len() != SLH_DSA_PK_BYTES + SLH_DSA_SIG_BYTES {
+            return Err(FastCryptoError::InputLengthWrong(
+                1 + SLH_DSA_PK_BYTES + SLH_DSA_SIG_BYTES,
+            ));
+        }
+        let (pk, sig) = body.split_at(SLH_DSA_PK_BYTES);
+        Ok(SlhDsaAuthenticator {
+            pk: pk.to_vec(),
+            sig: sig.to_vec(),
+            bytes: OnceCell::new(),
+        })
+    }
+}
+
+/// `hash(intent || bcs(tx))` — Blake2b256 (`DefaultHash`), matching every other scheme.
+fn to_signing_message<T: Serialize>(
+    intent_msg: &IntentMessage<T>,
+) -> [u8; DefaultHash::OUTPUT_SIZE] {
+    let mut hasher = DefaultHash::default();
+    bcs::serialize_into(&mut hasher, intent_msg).expect("serialization should not fail");
+    hasher.finalize().digest
+}
+
+/// Inline FIPS-205 SLH-DSA-SHA2-128s verify via RustCrypto `slh-dsa`.
+fn slh_dsa_verify(pk: &[u8], message: &[u8], sig: &[u8]) -> bool {
+    use slh_dsa::signature::Verifier;
+    use slh_dsa::{Sha2_128s, Signature, VerifyingKey};
+    if pk.len() != SLH_DSA_PK_BYTES || sig.len() != SLH_DSA_SIG_BYTES {
+        return false;
+    }
+    let Ok(vk) = VerifyingKey::<Sha2_128s>::try_from(pk) else { return false; };
+    let Ok(s) = Signature::<Sha2_128s>::try_from(sig) else { return false; };
+    vk.verify(message, &s).is_ok()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::crypto::{SlhDsaKeyPair, SuiKeyPair};
+    use shared_crypto::intent::{Intent, PersonalMessage};
+
+    /// `from_ikm` is a deterministic function of its input keying material — the
+    /// property that makes BIP-39 mnemonic derivation reproducible.
+    #[test]
+    fn from_ikm_is_deterministic() {
+        let a = SlhDsaKeyPair::from_ikm(b"sui-pq-test-ikm");
+        let b = SlhDsaKeyPair::from_ikm(b"sui-pq-test-ikm");
+        assert_eq!(a.public_key_bytes(), b.public_key_bytes());
+        assert_eq!(a.to_bytes(), b.to_bytes());
+        assert_eq!(a.public_key_bytes().len(), SLH_DSA_PK_BYTES);
+        assert_eq!(a.to_bytes().len(), 64);
+        let c = SlhDsaKeyPair::from_ikm(b"a-different-ikm");
+        assert_ne!(a.public_key_bytes(), c.public_key_bytes());
+    }
+
+    /// An SLH-DSA public key round-trips through Base64 (the form stored in the
+    /// keystore `sui.aliases` file and re-parsed on every wallet load).
+    #[test]
+    fn public_key_base64_round_trips() {
+        use crate::crypto::{EncodeDecodeBase64, SlhDsaKeyPair, SuiKeyPair};
+        let pk = SuiKeyPair::SlhDsa(SlhDsaKeyPair::from_ikm(b"pk-roundtrip")).public();
+        let b64 = pk.encode_base64();
+        let back = PublicKey::decode_base64(&b64).expect("SLH-DSA public key must round-trip");
+        assert_eq!(pk, back);
+        assert_eq!(pk.flag(), SignatureScheme::SlhDsa.flag());
+    }
+
+    /// A key pair derived purely from input keying material signs an intent
+    /// message, and the signature the validator recomputes-and-verifies passes —
+    /// proving a mnemonic-derived SLH-DSA key produces validator-acceptable
+    /// signatures with no elliptic curve anywhere in the path.
+    #[test]
+    fn sign_secure_generic_round_trips_through_verify() {
+        let kp = SuiKeyPair::SlhDsa(SlhDsaKeyPair::from_ikm(b"sui-pq-sign-test"));
+        let msg = PersonalMessage {
+            message: b"post-quantum hello".to_vec(),
+        };
+        let intent_msg = IntentMessage::new(Intent::personal_message(), msg);
+
+        let generic = kp.sign_secure_generic(&intent_msg);
+        let auth = match &generic {
+            crate::signature::GenericSignature::SlhDsaAuthenticator(a) => a,
+            other => panic!("expected SlhDsaAuthenticator, got {other:?}"),
+        };
+
+        // Wire blob = flag(0x07) || pk(32) || sig(7856).
+        let blob = auth.as_ref();
+        assert_eq!(blob.len(), 1 + SLH_DSA_PK_BYTES + SLH_DSA_SIG_BYTES);
+        assert_eq!(blob[0], SignatureScheme::SlhDsa.flag());
+
+        // The signature verifies over exactly the digest the validator computes
+        // in `verify_claims` (Blake2b256 of the BCS-encoded intent message).
+        let digest = to_signing_message(&intent_msg);
+        let pk = &blob[1..1 + SLH_DSA_PK_BYTES];
+        let sig = &blob[1 + SLH_DSA_PK_BYTES..];
+        assert!(
+            slh_dsa_verify(pk, &digest, sig),
+            "validator-side SLH-DSA verify must accept the produced signature"
+        );
+
+        // A tampered message must be rejected.
+        let mut bad = digest;
+        bad[0] ^= 0xff;
+        assert!(!slh_dsa_verify(pk, &bad, sig));
+    }
+}
