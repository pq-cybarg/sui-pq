+/// [SuiKeyPair::sign_secure_generic], which yields a native
+/// [GenericSignature::SlhDsaAuthenticator].
+#[derive(PartialEq, Eq)]
+pub struct SlhDsaKeyPair {
+    signing_key: SlhDsaSigningKey<Sha2_128s>,
+}
+
+impl Debug for SlhDsaKeyPair {
+    fn fmt(&self, f: &mut Formatter<'_>) -> fmt::Result {
+        // Never print the secret; the public key is enough to identify the key.
+        f.debug_struct("SlhDsaKeyPair")
+            .field("public", &Hex::encode(self.public_key_bytes()))
