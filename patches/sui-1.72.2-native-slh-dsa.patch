+# Local PQ fork: teaches sui-sdk-types the SLH-DSA (0x07) scheme so the gRPC
+# transaction-submission path can carry post-quantum signatures, letting
+# `sui client transfer …` work natively for SLH-DSA accounts. The fork is
+# cloned as a sibling of this repo by scripts/build-pq-validator.sh and patched
+# with patches/sui-rust-sdk-slh-dsa.patch (against the same rev pinned above).
+[patch."https://github.com/MystenLabs/sui-rust-sdk.git"]
+sui-sdk-types = { path = "../sui-rust-sdk/crates/sui-sdk-types" }
+sui-crypto = { path = "../sui-rust-sdk/crates/sui-crypto" }
+sui-rpc = { path = "../sui-rust-sdk/crates/sui-rpc" }
+
